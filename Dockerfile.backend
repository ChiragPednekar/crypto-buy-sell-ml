# BACKEND DOCKERFILE
FROM python:3.9-slim

WORKDIR /app
COPY requirements.txt .

# Install dependencies (Phase 4: Scaling production architecture)
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install fastapi uvicorn sqlalchemy passlib[bcrypt] python-jose cryptography ccxt websockets python-multipart

COPY ./src /app/src
COPY ./models /app/models
COPY ./data /app/data

EXPOSE 8000
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
